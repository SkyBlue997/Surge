#!name=🍿️ Netflix 双语字幕 (LLM)
#!desc=Netflix 双语字幕, 支持 OpenAI / Anthropic / DeepL 翻译, 按上下文分批翻译 (附带前后台词与可选的剧情提示), 结果本地缓存。API Key 与模型均在模块参数中填写。基于 DualSubs/Netflix v0.6.0 改写。
#!category=🍿️ DualSubs
#!author=SkyBlue997
#!homepage=https://github.com/SkyBlue997/Surge/tree/main/Netflix
#!icon=https://github.com/DualSubs/Netflix/raw/main/src/assets/icon_rounded.png
#!arguments=Vendor:"OpenAI",Source:"AUTO",Target:"ZH-HANS",Position:"Forward",ShowOnly:false,OpenAIKey:"",OpenAIModel:"gpt-5-mini",OpenAIBaseURL:"https://api.openai.com/v1",OpenAIEffort:"minimal",AnthropicKey:"",AnthropicModel:"claude-opus-5-5",AnthropicBaseURL:"https://api.anthropic.com",AnthropicEffort:"low",DeepLKey:"",DeepLBaseURL:"",ContextLines:"8",BatchSize:"20",Concurrency:"16",Timeout:"30",Hint:"",CacheSize:"3",LogLevel:"WARN"
#!arguments-desc=Vendor: [翻译器] 服务商\n    ├ OpenAI: OpenAI Chat Completions (也可填任意 OpenAI 兼容接口)\n    ├ Anthropic: Anthropic Messages API (Claude)\n    └ DeepL: DeepL API (Free / Pro 按 Key 自动识别)\n\nSource: [字幕] 源语言\n    ├ AUTO: 自动识别\n    ├ EN / ES / JA / KO / DE / FR / TR / KM\n    └ ZH / ZH-HANS / ZH-HANT / ZH-HK\n仅当自动识别不准时修改。\n\nTarget: [字幕] 目标语言\n    ├ ZH-HANS: 简体中文\n    ├ ZH-HANT: 繁体中文 (台湾)\n    ├ ZH-HK: 繁体中文 (香港)\n    └ EN / ES / JA / KO / DE / FR / TR / KM\n若原字幕已是目标语言, 不做翻译。\n\nPosition: [字幕] 原文位置\n    ├ Forward: 原文在上, 译文在下\n    └ Reverse: 译文在上, 原文在下\n\nShowOnly: [字幕] 只显示译文\n\nOpenAIKey: [OpenAI] API Key (sk-...)\nOpenAIModel: [OpenAI] 模型, 默认 gpt-5-mini\nOpenAIBaseURL: [OpenAI] 接口地址, 默认 https://api.openai.com/v1\n可改为其他 OpenAI 兼容接口 (会请求 <BaseURL>/chat/completions)。\nOpenAIEffort: [OpenAI] reasoning_effort\n推理模型 (gpt-5 / o 系列) 建议 minimal 或 low 以降低延迟; 非推理模型或不支持该参数的第三方接口请留空。\n\nAnthropicKey: [Anthropic] API Key (sk-ant-...)\nAnthropicModel: [Anthropic] 模型, 默认 claude-opus-5-5\n可改为 claude-sonnet-5-5 / claude-haiku-5-5 等更快更便宜的模型。\nAnthropicBaseURL: [Anthropic] 接口地址, 默认 https://api.anthropic.com\nAnthropicEffort: [Anthropic] effort (low / medium / high), 留空则使用模型默认值。\n\nDeepLKey: [DeepL] API Key\n以 :fx 结尾的 Key 自动使用 api-free.deepl.com。\nDeepLBaseURL: [DeepL] 自定义接口地址, 通常留空。\n\nContextLines: [上下文] 每批附带的前后台词行数, 默认 8, 填 0 关闭。\nBatchSize: [上下文] 每批翻译的台词条数, 默认 20 (DeepL 最多 50)。\n越大单次请求越慢; 上下文主要靠 ContextLines。\nConcurrency: [性能] 同时发出的请求数, 默认 16。\n一集通常 30~50 批, 并发越高越快翻完; API 额度低时如遇 429 可调小。\nTimeout: [性能] 限时 (秒), 默认 30。\n播放器不会无限等待字幕, 到时先返回已翻译的部分 (从开头往后), 其余显示原文; 再次选择该字幕会继续翻译剩余部分。\nHint: [上下文] 补充背景 (可选)\n例如剧名、人物译名、称谓偏好: 怪奇物语; Eleven 译作 小十一。请勿包含英文双引号。\nCacheSize: [缓存] 本地缓存最近几集的译文, 默认 3, 填 0 关闭。\n\nLogLevel: [调试] 日志等级\n    ├ OFF / ERROR / WARN / INFO / DEBUG / ALL\n

[Script]
🍿️ Netflix.LLM.Translate.Subtitles = type=http-response, pattern=^https?:\/\/(.+)\.oca\.nflxvideo\.net\/\?o=\d+&v=\d+&e=\d+&t=.+, requires-body=1, timeout=120, script-path=https://raw.githubusercontent.com/SkyBlue997/Surge/main/Netflix/Netflix.Translate.response.js, argument="Vendor={{{Vendor}}}&Source={{{Source}}}&Target={{{Target}}}&Position={{{Position}}}&ShowOnly={{{ShowOnly}}}&OpenAIKey={{{OpenAIKey}}}&OpenAIModel={{{OpenAIModel}}}&OpenAIBaseURL={{{OpenAIBaseURL}}}&OpenAIEffort={{{OpenAIEffort}}}&AnthropicKey={{{AnthropicKey}}}&AnthropicModel={{{AnthropicModel}}}&AnthropicBaseURL={{{AnthropicBaseURL}}}&AnthropicEffort={{{AnthropicEffort}}}&DeepLKey={{{DeepLKey}}}&DeepLBaseURL={{{DeepLBaseURL}}}&ContextLines={{{ContextLines}}}&BatchSize={{{BatchSize}}}&Concurrency={{{Concurrency}}}&Timeout={{{Timeout}}}&Hint={{{Hint}}}&CacheSize={{{CacheSize}}}&LogLevel={{{LogLevel}}}"

[MITM]
hostname = %APPEND% *.oca.nflxvideo.net
tcp-connection = true
