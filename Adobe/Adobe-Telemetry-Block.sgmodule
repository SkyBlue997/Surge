#!name=Adobe Telemetry Block
#!desc=Block Adobe telemetry / genuine-check domains at the app layer (Surge REJECT). No /etc/hosts, no root daemon. Converted from the a-dove-is-dumb list (4333 domains). Updated 2026-07-17.
#!category=Privacy
#!author=SkyBlue997
#!homepage=https://github.com/SkyBlue997/Surge

[Rule]
# Stable suffixes — cover 4253/4333 domains, never drift
DOMAIN-SUFFIX,adobestats.io,REJECT
DOMAIN-SUFFIX,hstatic.io,REJECT
