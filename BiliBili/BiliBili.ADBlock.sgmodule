#!name=📺 哔哩哔哩去广告 + CDN 自定义
#!desc=去除开屏、推荐流、Story、播放页、动态、评论、搜索、直播等处的广告，可选净化「我的」页与底栏；视频分片可重定向到指定 CDN，或按网络自动测速选择最快节点 (兼容 HTTPDNS 直连 IP，失败自动回退)。gRPC 接口按字段编号就地修改，不依赖第三方库。
#!category=📺 BiliBili
#!author=SkyBlue997
#!homepage=https://github.com/SkyBlue997/Surge/tree/main/BiliBili
#!icon=https://raw.githubusercontent.com/Biliverse/ADBlock/main/src/assets/icon_rounded.png
#!arguments=Splash:true,Feed.AD:true,Feed.Vertical:false,Feed.BlockUpLiveList:"",Story.AD:true,Search.AD:true,Search.HotSearch:true,View.AD:true,Dynamic.AD:true,Dynamic.HotTopics:true,Dynamic.MostVisited:"KEEP",Reply.AD:true,Reply.EditorCommercial:false,DM.Command:false,DM.Colorful:false,PGC.AD:true,Live.AD:true,Mine.Clean:true,Tab.Clean:true,Teenagers:true,CDN.UPOS:"AUTO",CDN.PCDN:"UPOS",CDN.Candidates:"upos-sz-mirrorcosov.bilivideo.com|upos-sz-mirroraliov.bilivideo.com|upos-sz-mirrorhwov.bilivideo.com|cn-hk-eq-01-01.bilivideo.com|cn-hk-eq-01-09.bilivideo.com|cn-hk-eq-01-12.bilivideo.com|cn-hk-eq-01-14.bilivideo.com|upos-sz-mirrorali.bilivideo.com|upos-sz-mirrorcos.bilivideo.com|upos-sz-mirrorhw.bilivideo.com",CDN.TestSize:"512",CDN.TTL:"60",LogLevel:"WARN"
#!arguments-desc=Splash: [开屏] 去除开屏广告\n\nFeed.AD: [推荐] 去除推荐流广告 (含大图轮播中的广告)\n\nFeed.Vertical: [推荐] 去除推荐流中的竖屏视频\n\nFeed.BlockUpLiveList: [推荐] 屏蔽这些 UP 主的直播推荐\n填写 UID，多个用英文逗号分隔。\n\nStory.AD: [Story] 去除竖屏视频流广告、「助TA必火」按钮与购物车挂件\n\nSearch.AD: [搜索] 去除搜索结果中的广告与游戏推广\n\nSearch.HotSearch: [搜索] 去除搜索页「热搜」\n\nView.AD: [播放页] 去除播放页广告\n包括：简介下方推广卡、相关推荐里的广告、大会员横幅、UP 主好物、播放中弹出的推广素材、暂停广告、结束页广告、片头广告片段。\n\nDynamic.AD: [动态] 去除动态流广告卡片\n\nDynamic.HotTopics: [动态] 去除「热门话题」\n\nDynamic.MostVisited: [动态] 「最常访问」\n    ├ KEEP: 保留\n    ├ LIVE: 只保留正在直播的\n    └ REMOVE: 整栏去除\n\nReply.AD: [评论] 去除评论区广告、带货置顶评论与商业卡片\n\nReply.EditorCommercial: [评论] 去除评论输入框里的商品 / 商业助手按钮\n\nDM.Command: [弹幕] 去除交互式弹幕 (投票、关注提示等)\n\nDM.Colorful: [弹幕] 把大会员彩色渐变弹幕还原为普通弹幕\n\nPGC.AD: [番剧影视] 去除番剧 / 影视页广告与试看提示\n\nLive.AD: [直播] 去除直播推荐广告、直播间活动横幅与购物车\n\nMine.Clean: [我的] 去除推广入口\n包括：商业服务、花火、必火推广、游戏中心、小店、工房、活动页入口。\n\nTab.Clean: [界面] 去除底栏「会员购」、顶栏「游戏中心」与首页活动标签页\n\nTeenagers: [其他] 屏蔽青少年模式弹窗\n\nCDN.UPOS: [CDN] 把官方 CDN 上的视频重定向到此主机\n    ├ AUTO: 自动测速，按网络选择最快节点\n    ├ OFF: 不改写\n    ├ upos-sz-mirrorcosov.bilivideo.com: 腾讯云，海外\n    ├ upos-sz-mirroraliov.bilivideo.com: 阿里云，海外\n    ├ upos-sz-mirrorhwov.bilivideo.com: 华为云，海外\n    ├ cn-hk-eq-01-12.bilivideo.com: Equinix 香港 (01-01/03/09/10/13/14 同类)\n    ├ upos-sz-mirrorali.bilivideo.com: 阿里云\n    ├ upos-sz-mirrorcos.bilivideo.com: 腾讯云\n    └ upos-sz-mirrorhw.bilivideo.com: 华为云\n也可填写任意 bilivideo.com 主机。Akamai (akamaized.net) 只能作来源，不能作目标，否则会 403。\n选中的节点返回错误时，会自动 302 回原地址并在下次重新测速。\n\nCDN.PCDN: [CDN] PCDN / MCDN 节点 (家庭宽带 P2P，常导致卡顿) 的处理方式\n    ├ OFF: 不改写\n    ├ UPOS: 改回官方 CDN (优先使用 CDN.UPOS，否则使用链接自带的源站)\n    └ 填写主机名: 重定向到指定主机\n\nCDN.Candidates: [CDN 测速] 参与测速的主机\n用 | 或英文逗号分隔；视频原本使用的主机也会自动参与比较。\n\nCDN.TestSize: [CDN 测速] 每个节点下载多少 KB 来测速\n默认 512，范围 64–4096。越大越准，也越费流量。\n\nCDN.TTL: [CDN 测速] 测速结果有效期 (分钟)\n默认 60。过期后先沿用旧结果，由后台每 30 分钟检查一次 (仅在近 2 小时看过视频时测速) 和网络切换时完整测速；当前网络没有任何结果时，播放第一个分片时竞速一次。\n首页面板「B站 CDN」可查看排名，点按刷新立即完整测速。\n\nLogLevel: [调试] 日志等级\n    ├ OFF / ERROR / WARN\n    └ INFO / DEBUG: 输出每次去除的数量与 CDN 改写记录

[General]
# PCDN / MCDN 使用非标准端口，交给 HTTP 引擎才能被脚本改写
force-http-engine-hosts = %APPEND% *:4480, *:4483, *:8000, *:8082, *:9102

[Map Local]
# 搜索框默认词：最小合法的空 gRPC 帧
^https?:\/\/(?:grpc\.biliapi\.net|app\.bilibili\.com|app\.biliapi\.(?:net|com))\/bilibili\.app\.interface\.v1\.Search\/DefaultWords$ data-type=base64 data="AAAAAAA=" status-code=200 header="Content-Type:application/grpc|grpc-status:0"
# 搜索「大家都在搜」、动态话题、最常访问 (旧接口)
^https?:\/\/api\.vc\.bilibili\.com\/search_svr\/v\d\/Search\/recommend_words data-type=text data="{}" status-code=200 header="Content-Type:application/json"
^https?:\/\/api\.vc\.bilibili\.com\/topic_svr\/v1\/topic_svr data-type=text data="{}" status-code=200 header="Content-Type:application/json"
^https?:\/\/api\.vc\.bilibili\.com\/dynamic_svr\/v1\/dynamic_svr\/mix_uplist data-type=text data="{}" status-code=200 header="Content-Type:application/json"
# 漫画开屏
^https?:\/\/manga\.bilibili\.com\/twirp\/comic\.v\d\.Comic\/(?:Flash|ListFlash) data-type=text data="{}" status-code=200 header="Content-Type:application/json"
# 直播间购物车
^https?:\/\/api\.live\.bilibili\.com\/xlive\/e-commerce-interface\/v1\/ecommerce-user\/get_shopping_info\? data-type=text data="{}" status-code=200 header="Content-Type:application/json"
# 番剧页弹窗广告
^https?:\/\/api\.bilibili\.com\/pgc\/activity\/deliver\/material\/receive\? data-type=base64 data="eyJjb2RlIjowLCJkYXRhIjp7ImNsb3NlVHlwZSI6ImNsb3NlX3dpbiIsImNvbnRhaW5lciI6W10sInNob3dUaW1lIjoiIn0sIm1lc3NhZ2UiOiJzdWNjZXNzIn0=" status-code=200 header="Content-Type:application/json"

[Body Rewrite]
# iPad 番剧详情页上方的付费推广
http-response-jq ^https?:\/\/api\.bilibili\.com\/pgc\/view\/v2\/app\/season\? 'del(.data.payment)'

[Script]
📺 BiliBili.ADBlock.app.json = type=http-response, pattern=^https?:\/\/app\.bili(?:bili\.com|api\.(?:net|com))\/x\/(?:v2\/(?:splash\/(?:list|show|brand\/list|event\/list2)|feed\/index(?:\/story(?:\/cart)?|\/relate\/story)?|search\/square|account\/mine)|resource\/show\/tab\/v2)(?:\?|$), requires-body=1, max-size=2097152, script-path=https://raw.githubusercontent.com/SkyBlue997/Surge/main/BiliBili/BiliBili.ADBlock.js, argument="Splash={{{Splash}}}&Feed.AD={{{Feed.AD}}}&Feed.Vertical={{{Feed.Vertical}}}&Feed.BlockUpLiveList={{{Feed.BlockUpLiveList}}}&Story.AD={{{Story.AD}}}&Search.AD={{{Search.AD}}}&Search.HotSearch={{{Search.HotSearch}}}&View.AD={{{View.AD}}}&Dynamic.AD={{{Dynamic.AD}}}&Dynamic.HotTopics={{{Dynamic.HotTopics}}}&Dynamic.MostVisited={{{Dynamic.MostVisited}}}&Reply.AD={{{Reply.AD}}}&Reply.EditorCommercial={{{Reply.EditorCommercial}}}&DM.Command={{{DM.Command}}}&DM.Colorful={{{DM.Colorful}}}&PGC.AD={{{PGC.AD}}}&Live.AD={{{Live.AD}}}&Mine.Clean={{{Mine.Clean}}}&Tab.Clean={{{Tab.Clean}}}&Teenagers={{{Teenagers}}}&LogLevel={{{LogLevel}}}"
📺 BiliBili.ADBlock.api.json = type=http-response, pattern=^https?:\/\/api\.bili(?:bili\.com|api\.net)\/(?:x\/(?:vip\/ads\/materials|web-interface\/wbi\/index\/top\/feed\/rcmd)|pgc\/page\/(?:bangumi|cinema\/tab))(?:\?|$), requires-body=1, max-size=2097152, script-path=https://raw.githubusercontent.com/SkyBlue997/Surge/main/BiliBili/BiliBili.ADBlock.js, argument="Splash={{{Splash}}}&Feed.AD={{{Feed.AD}}}&Feed.Vertical={{{Feed.Vertical}}}&Feed.BlockUpLiveList={{{Feed.BlockUpLiveList}}}&Story.AD={{{Story.AD}}}&Search.AD={{{Search.AD}}}&Search.HotSearch={{{Search.HotSearch}}}&View.AD={{{View.AD}}}&Dynamic.AD={{{Dynamic.AD}}}&Dynamic.HotTopics={{{Dynamic.HotTopics}}}&Dynamic.MostVisited={{{Dynamic.MostVisited}}}&Reply.AD={{{Reply.AD}}}&Reply.EditorCommercial={{{Reply.EditorCommercial}}}&DM.Command={{{DM.Command}}}&DM.Colorful={{{DM.Colorful}}}&PGC.AD={{{PGC.AD}}}&Live.AD={{{Live.AD}}}&Mine.Clean={{{Mine.Clean}}}&Tab.Clean={{{Tab.Clean}}}&Teenagers={{{Teenagers}}}&LogLevel={{{LogLevel}}}"
📺 BiliBili.ADBlock.live.json = type=http-response, pattern=^https?:\/\/api\.live\.bilibili\.com\/xlive\/(?:app-room\/v1\/index\/getInfoByRoom|app-interface\/v2\/(?:index\/feed|room\/recList))(?:\?|$), requires-body=1, max-size=2097152, script-path=https://raw.githubusercontent.com/SkyBlue997/Surge/main/BiliBili/BiliBili.ADBlock.js, argument="Splash={{{Splash}}}&Feed.AD={{{Feed.AD}}}&Feed.Vertical={{{Feed.Vertical}}}&Feed.BlockUpLiveList={{{Feed.BlockUpLiveList}}}&Story.AD={{{Story.AD}}}&Search.AD={{{Search.AD}}}&Search.HotSearch={{{Search.HotSearch}}}&View.AD={{{View.AD}}}&Dynamic.AD={{{Dynamic.AD}}}&Dynamic.HotTopics={{{Dynamic.HotTopics}}}&Dynamic.MostVisited={{{Dynamic.MostVisited}}}&Reply.AD={{{Reply.AD}}}&Reply.EditorCommercial={{{Reply.EditorCommercial}}}&DM.Command={{{DM.Command}}}&DM.Colorful={{{DM.Colorful}}}&PGC.AD={{{PGC.AD}}}&Live.AD={{{Live.AD}}}&Mine.Clean={{{Mine.Clean}}}&Tab.Clean={{{Tab.Clean}}}&Teenagers={{{Teenagers}}}&LogLevel={{{LogLevel}}}"
📺 BiliBili.ADBlock.view.grpc = type=http-response, pattern=^https?:\/\/(?:grpc\.biliapi\.net|app\.bilibili\.com|app\.biliapi\.(?:net|com))\/bilibili\.app\.(?:playerunite\.v1\.Player\/PlayViewUnite|viewunite\.v1\.View\/(?:View|AIRelateAsync|RelatesFeed|ViewProgress|PlayPause|ViewEndPage))$, requires-body=1, binary-body-mode=1, max-size=2097152, script-path=https://raw.githubusercontent.com/SkyBlue997/Surge/main/BiliBili/BiliBili.ADBlock.js, argument="Splash={{{Splash}}}&Feed.AD={{{Feed.AD}}}&Feed.Vertical={{{Feed.Vertical}}}&Feed.BlockUpLiveList={{{Feed.BlockUpLiveList}}}&Story.AD={{{Story.AD}}}&Search.AD={{{Search.AD}}}&Search.HotSearch={{{Search.HotSearch}}}&View.AD={{{View.AD}}}&Dynamic.AD={{{Dynamic.AD}}}&Dynamic.HotTopics={{{Dynamic.HotTopics}}}&Dynamic.MostVisited={{{Dynamic.MostVisited}}}&Reply.AD={{{Reply.AD}}}&Reply.EditorCommercial={{{Reply.EditorCommercial}}}&DM.Command={{{DM.Command}}}&DM.Colorful={{{DM.Colorful}}}&PGC.AD={{{PGC.AD}}}&Live.AD={{{Live.AD}}}&Mine.Clean={{{Mine.Clean}}}&Tab.Clean={{{Tab.Clean}}}&Teenagers={{{Teenagers}}}&LogLevel={{{LogLevel}}}"
📺 BiliBili.ADBlock.feed.grpc = type=http-response, pattern=^https?:\/\/(?:grpc\.biliapi\.net|app\.bilibili\.com|app\.biliapi\.(?:net|com))\/bilibili\.(?:app\.(?:dynamic\.v2\.Dynamic\/Dyn(?:All|Video)(?:Personal)?|interface\.v1\.Teenagers\/ModeStatus)|main\.community\.reply\.v(?:1\.Reply\/MainList|2\.Reply\/SubjectDescription)|polymer\.app\.search\.v1\.Search\/SearchAll|pgc\.gateway\.player\.v2\.PlayURL\/PlayView)$, requires-body=1, binary-body-mode=1, max-size=2097152, script-path=https://raw.githubusercontent.com/SkyBlue997/Surge/main/BiliBili/BiliBili.ADBlock.js, argument="Splash={{{Splash}}}&Feed.AD={{{Feed.AD}}}&Feed.Vertical={{{Feed.Vertical}}}&Feed.BlockUpLiveList={{{Feed.BlockUpLiveList}}}&Story.AD={{{Story.AD}}}&Search.AD={{{Search.AD}}}&Search.HotSearch={{{Search.HotSearch}}}&View.AD={{{View.AD}}}&Dynamic.AD={{{Dynamic.AD}}}&Dynamic.HotTopics={{{Dynamic.HotTopics}}}&Dynamic.MostVisited={{{Dynamic.MostVisited}}}&Reply.AD={{{Reply.AD}}}&Reply.EditorCommercial={{{Reply.EditorCommercial}}}&DM.Command={{{DM.Command}}}&DM.Colorful={{{DM.Colorful}}}&PGC.AD={{{PGC.AD}}}&Live.AD={{{Live.AD}}}&Mine.Clean={{{Mine.Clean}}}&Tab.Clean={{{Tab.Clean}}}&Teenagers={{{Teenagers}}}&LogLevel={{{LogLevel}}}"
📺 BiliBili.ADBlock.dm.grpc = type=http-response, pattern=^https?:\/\/(?:grpc\.biliapi\.net|app\.bilibili\.com|app\.biliapi\.(?:net|com))\/bilibili\.community\.service\.dm\.v1\.DM\/(?:DmView|DmSegMobile)$, requires-body=1, binary-body-mode=1, max-size=2097152, script-path=https://raw.githubusercontent.com/SkyBlue997/Surge/main/BiliBili/BiliBili.ADBlock.js, argument="Splash={{{Splash}}}&Feed.AD={{{Feed.AD}}}&Feed.Vertical={{{Feed.Vertical}}}&Feed.BlockUpLiveList={{{Feed.BlockUpLiveList}}}&Story.AD={{{Story.AD}}}&Search.AD={{{Search.AD}}}&Search.HotSearch={{{Search.HotSearch}}}&View.AD={{{View.AD}}}&Dynamic.AD={{{Dynamic.AD}}}&Dynamic.HotTopics={{{Dynamic.HotTopics}}}&Dynamic.MostVisited={{{Dynamic.MostVisited}}}&Reply.AD={{{Reply.AD}}}&Reply.EditorCommercial={{{Reply.EditorCommercial}}}&DM.Command={{{DM.Command}}}&DM.Colorful={{{DM.Colorful}}}&PGC.AD={{{PGC.AD}}}&Live.AD={{{Live.AD}}}&Mine.Clean={{{Mine.Clean}}}&Tab.Clean={{{Tab.Clean}}}&Teenagers={{{Teenagers}}}&LogLevel={{{LogLevel}}}"
📺 BiliBili.CDN = type=http-request, pattern=^https?:\/\/[^\/]+\/upgcxcode\/, timeout=10, script-path=https://raw.githubusercontent.com/SkyBlue997/Surge/main/BiliBili/BiliBili.CDN.js, argument="Mode=request&CDN.UPOS={{{CDN.UPOS}}}&CDN.PCDN={{{CDN.PCDN}}}&CDN.Candidates={{{CDN.Candidates}}}&CDN.TestSize={{{CDN.TestSize}}}&CDN.TTL={{{CDN.TTL}}}&LogLevel={{{LogLevel}}}"
📺 BiliBili.CDN.fallback = type=http-response, pattern=^https?:\/\/[^\/]+\/upgcxcode\/, script-path=https://raw.githubusercontent.com/SkyBlue997/Surge/main/BiliBili/BiliBili.CDN.js, argument="Mode=response&CDN.UPOS={{{CDN.UPOS}}}&CDN.PCDN={{{CDN.PCDN}}}&CDN.Candidates={{{CDN.Candidates}}}&CDN.TestSize={{{CDN.TestSize}}}&CDN.TTL={{{CDN.TTL}}}&LogLevel={{{LogLevel}}}"
📺 BiliBili.CDN.panel = type=generic, timeout=120, script-path=https://raw.githubusercontent.com/SkyBlue997/Surge/main/BiliBili/BiliBili.CDN.js, argument="Mode=panel&CDN.UPOS={{{CDN.UPOS}}}&CDN.PCDN={{{CDN.PCDN}}}&CDN.Candidates={{{CDN.Candidates}}}&CDN.TestSize={{{CDN.TestSize}}}&CDN.TTL={{{CDN.TTL}}}&LogLevel={{{LogLevel}}}"
📺 BiliBili.CDN.network = type=event, event-name=network-changed, timeout=120, script-path=https://raw.githubusercontent.com/SkyBlue997/Surge/main/BiliBili/BiliBili.CDN.js, argument="Mode=event&CDN.UPOS={{{CDN.UPOS}}}&CDN.PCDN={{{CDN.PCDN}}}&CDN.Candidates={{{CDN.Candidates}}}&CDN.TestSize={{{CDN.TestSize}}}&CDN.TTL={{{CDN.TTL}}}&LogLevel={{{LogLevel}}}"
📺 BiliBili.CDN.cron = type=cron, cronexp="*/30 * * * *", timeout=120, script-path=https://raw.githubusercontent.com/SkyBlue997/Surge/main/BiliBili/BiliBili.CDN.js, argument="Mode=cron&CDN.UPOS={{{CDN.UPOS}}}&CDN.PCDN={{{CDN.PCDN}}}&CDN.Candidates={{{CDN.Candidates}}}&CDN.TestSize={{{CDN.TestSize}}}&CDN.TTL={{{CDN.TTL}}}&LogLevel={{{LogLevel}}}"

[Panel]
BiliBili.CDN = script-name=📺 BiliBili.CDN.panel, update-interval=3600

[MITM]
# 前半为接口域名，后半为视频 CDN (仅 CDN 自定义 / 测速需要；CDN.UPOS 与 CDN.PCDN 都设为 OFF 时可删去 upos-* 之后的部分以节省性能)
hostname = %APPEND% app.bilibili.com, app.biliapi.net, app.biliapi.com, grpc.biliapi.net, api.bilibili.com, api.biliapi.net, api.live.bilibili.com, api.vc.bilibili.com, manga.bilibili.com, upos-*.bilivideo.com, cn-*.bilivideo.com, upos-*.akamaized.net, *.mcdn.bilivideo.cn, *.szbdyd.com
h2 = true
